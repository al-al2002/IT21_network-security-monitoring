# NetGuard backend — example environment file
# Copy to .env and fill in your real values. NEVER commit .env to git.

# MongoDB Atlas connection string. Get it from Atlas dashboard:
#   Cluster -> Connect -> Drivers -> "mongodb+srv://..."
# Make sure to whitelist your IP (0.0.0.0/0 is fine for development).
MONGO_URI=

# Any long random string. Used to sign JWTs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Express server port
PORT=5000

# React dev server origin (for CORS)
CLIENT_URL=http://localhost:5173

# --- Event source -------------------------------------------------------
# Where background events come from:
#   replay    (default) real CIC-IDS2017 flows from data/cicids2017-sample.csv
#   simulator synthetic random events (fallback)
#   none      no background events — only real login attempts to NetGuard
# Real login attempts are recorded as events in every mode.
EVENT_SOURCE=replay
REPLAY_INTERVAL_MS=5000
REPLAY_BATCH_SIZE=3

# --- Threat intelligence --------------------------------------------------
# The Blacklisted IP rule checks events against the abuse.ch Feodo Tracker
# botnet C2 blocklist. No API key needed. How often to re-download it:
THREAT_FEED_REFRESH_HOURS=6

# --- Deployment -----------------------------------------------------------
# Which proxies may report the client's real IP (X-Forwarded-For).
# Leave unset locally ("loopback" = the Vite dev proxy). On Render use 1.
# TRUST_PROXY=1

# Auto-delete events older than this many days (MongoDB TTL index). Keeps a
# free 512 MB Atlas cluster from filling up. WARNING: applies to the whole
# database as soon as the server starts, deleting older events immediately.
# EVENT_RETENTION_DAYS=7

# --- Optional: automatic Atlas IP allow-listing -------------------------
# Lets "npm run dev" add this computer's current public IP to the Atlas
# access list automatically, so you never have to open cloud.mongodb.com
# when your internet reconnects and your IP changes.
#
# Create the key at: Atlas -> Access Manager -> API Keys -> Create API Key
# Give it the "Project IP Access List Admin" role.
# Find the project ID at: Atlas -> Project Settings -> Project ID
#
# Leave these blank to disable the feature (nothing breaks).
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=
